@model NCCS_Lab_MVC.Models.Employee
@{
    ViewData["Title"] = "Employee Registration";
}

<h2>Employee Registration</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<form asp-action="Register" method="post">
    <!-- asp-validation-summary Tag Helper: shows all validation errors -->
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Name"></label>
        <!-- asp-for Tag Helper: binds input to model property + enables client-side validation -->
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Age"></label>
        <input asp-for="Age" class="form-control" />
        <span asp-validation-for="Age" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <!-- asp-action Tag Helper: generates form action URL pointing to Register action -->
    <button type="submit" class="btn btn-primary">Register</button>
</form>

@section Scripts {
    <!-- jQuery unobtrusive validation scripts enable CLIENT-SIDE validation -->
    <partial name="_ValidationScriptsPartial" />
}
